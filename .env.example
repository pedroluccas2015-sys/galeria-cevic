# Public Firebase web configuration (use the existing project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=galeria-cevic
# Server only. Never prefix these with VITE_.
# Vercel Connect: use the actual connector UID returned after creation.
DRIVE_CONNECTOR_UID=
# Stable owner identity, configured by the administrator, never from user input.
DRIVE_SUBJECT_ID=cevic-owner
# Optional alternative to Vercel Connect: direct server OAuth credentials.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=1YCRroxrjvcyXFRDm6tyrtqI3TpS5UHKn
GALLERY_ADMIN_PASSWORD=
# At least 32 random characters.
GALLERY_SESSION_SECRET=
GALLERY_ORIGIN=https://galeria-cevic.vercel.app
